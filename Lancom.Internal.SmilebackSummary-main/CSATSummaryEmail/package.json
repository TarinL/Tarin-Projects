{
    "name": "CSAT-Summary-Email",
    "description": "sends-weekly-CSAT-summary-email",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "devDependencies": {
        "jest": "^29.2.1"
    },
    "scripts": {
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
    },
    "jest": {
        "testMatch": [
            "**/__tests__/**/*.[jt]s?(x)",
            "**/__tests__/**/*.mjs?(x)"
        ],
        "moduleFileExtensions": [
            "mjs",
            "js"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            ".aws-sam/"
        ]
    },
    "dependencies": {
        "@aws-sdk/client-ses": "^3.731.1",
        "dotenv": "^16.4.7"
    }
}
